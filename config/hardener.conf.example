# =============================================================================
# Linux Hardener Configuration Template
# Copy to config/hardener.conf and fill in your values.
# Lines marked __PLACEHOLDER__ must be replaced before use.
# =============================================================================

# -----------------------------------------------------------------------------
# Profile
# Controls the overall hardening aggressiveness.
# Options: minimal | standard | aggressive
# -----------------------------------------------------------------------------
HARDENING_PROFILE="aggressive"

# Global dry-run override: when "yes", an --apply run is demoted to dry-run
# (prints every change, writes nothing, restarts nothing).
DRY_RUN="no"

# -----------------------------------------------------------------------------
# SSH
# -----------------------------------------------------------------------------
SSH_PORT=22
SSH_PERMIT_ROOT_LOGIN="prohibit-password"
SSH_PASSWORD_AUTH="no"
SSH_ALLOW_TCP_FORWARDING="no"
SSH_ALLOW_AGENT_FORWARDING="no"

# -----------------------------------------------------------------------------
# SSH crypto policy (modules/25_ssh_crypto.sh)
# SSH_MODERN_CRYPTO: modern-only kex/cipher/MAC/host-key algorithms
#   (curve25519, chacha20/aes256-gcm, sha2-etm, ed25519 + RSA>=4096). Applied
#   via a drop-in, validated with sshd -t, then proven with a live localhost
#   handshake — the module auto-reverts if new connections cannot negotiate.
#   On RHEL the system-wide crypto policy is also raised to FUTURE (unless
#   LEGACY was explicitly chosen).
# SSH_ALLOWED_GROUPS: space-separated AllowGroups list; empty = no restriction.
#   Refused unless at least one user is a member (lock-out guard).
# -----------------------------------------------------------------------------
SSH_MODERN_CRYPTO="yes"
SSH_ALLOWED_GROUPS=""
SSH_LOGIN_GRACE_TIME=20
# SSH_CRYPTO_SYSTEM_POLICY: on RHEL, also raise the SYSTEM-WIDE crypto policy
#   to FUTURE. OFF by default — FUTURE rejects "too weak" TLS certs presented
#   by some package mirrors (e.g. mirrors.rockylinux.org) and breaks dnf
#   downloads. The sshd drop-in already enforces modern SSH crypto without it.
SSH_CRYPTO_SYSTEM_POLICY="no"

# -----------------------------------------------------------------------------
# Firewall
# Comma-separated list of allowed TCP/UDP inbound ports.
# Leave FIREWALL_ALLOWED_UDP_IN empty to block all UDP inbound.
# -----------------------------------------------------------------------------
FIREWALL_RESTRICT_OUTPUT="false"
FIREWALL_ALLOWED_TCP_IN="22"
FIREWALL_ALLOWED_UDP_IN=""

# -----------------------------------------------------------------------------
# Filesystem
# Mount /tmp and /dev/shm with noexec to prevent execution of binaries.
# -----------------------------------------------------------------------------
NOEXEC_TMP="true"
NOEXEC_DEV_SHM="true"

# -----------------------------------------------------------------------------
# Boot loader
# ENABLE_GRUB_PASSWORD: require credentials to EDIT boot entries (normal,
#   unattended booting is never affected — verified at apply time). A random
#   password is generated and printed ONCE unless GRUB_PASSWORD is set.
#   Defaults: aggressive=true, standard=false.
# -----------------------------------------------------------------------------
#ENABLE_GRUB_PASSWORD="true"
GRUB_PASSWORD=""

# -----------------------------------------------------------------------------
# Hardening extras
# ENABLE_TMPFS_TMP: mount /tmp as tmpfs when it is not a separate partition
#   (Lynis FILE-6310). ENABLE_COMPILER_RESTRICT: remove world access from
#   compiler binaries (Lynis HRDN-7222; package upgrades may restore modes).
#   Defaults: aggressive=true, standard=false.
# -----------------------------------------------------------------------------
#ENABLE_TMPFS_TMP="true"
#ENABLE_COMPILER_RESTRICT="true"

# -----------------------------------------------------------------------------
# Auth
# SHELL_TIMEOUT: idle shell timeout in seconds (900 = 15 minutes).
# LOGIN_BANNER_FILE: path to a custom banner file, or leave empty to use the
#   built-in banner (config/ssh-banner.txt).
# -----------------------------------------------------------------------------
SHELL_TIMEOUT=900
ENABLE_PASSWORD_POLICY="true"
ENABLE_LOGIN_BANNER="true"
LOGIN_BANNER_FILE=""

# -----------------------------------------------------------------------------
# Services
# FAIL2BAN_BANTIME: ban duration in seconds.
# -----------------------------------------------------------------------------
ENABLE_FAIL2BAN="true"
FAIL2BAN_MAXRETRY=5
FAIL2BAN_BANTIME=600

# -----------------------------------------------------------------------------
# Logging
# AUDITD_RULES: minimal | full
# -----------------------------------------------------------------------------
ENABLE_AUDITD="true"
AUDITD_RULES="minimal"
ENABLE_UNATTENDED_UPGRADES="true"

# -----------------------------------------------------------------------------
# Remote syslog (modules/50_remote_syslog.sh) — Lynis LOGG-2154
# RSYSLOG_REMOTE_HOST: "host:port" of the collector; empty disables forwarding.
#   Port defaults: 514 (tcp) / 6514 (tls). auth, kernel, and warning-or-worse
#   logs are forwarded with a bounded disk queue (100 MB) that retries through
#   collector outages without ever blocking local logging.
# RSYSLOG_REMOTE_PROTOCOL: tcp | tls (tls requires RSYSLOG_REMOTE_CERT, the
#   CA certificate that signed the collector's certificate).
# RSYSLOG_REMOTE_PERMITTED_PEER: name to verify in the collector's certificate
#   (x509/name); defaults to the host part of RSYSLOG_REMOTE_HOST.
# IPv6 collectors use bracketed form: [2001:db8::15]:6514
# -----------------------------------------------------------------------------
RSYSLOG_REMOTE_HOST=""
RSYSLOG_REMOTE_PROTOCOL="tcp"
RSYSLOG_REMOTE_CERT=""
RSYSLOG_REMOTE_PERMITTED_PEER=""

# -----------------------------------------------------------------------------
# Integrity
# Installs and initialises AIDE file-integrity monitoring.
# -----------------------------------------------------------------------------
ENABLE_AIDE="true"

# -----------------------------------------------------------------------------
# Sysctl
# ENABLE_MODULES_DISABLED: set kernel.modules_disabled=1 at the END of boot
#   (Lynis KRNL-6000). ONE-WAY until reboot: nothing can load kernel modules
#   afterwards — breaks on-demand module loading (LUKS module runtime, USB,
#   new filesystem mounts). Leave false unless the workload is fully static.
# -----------------------------------------------------------------------------
DISABLE_IPV6="false"
RESTRICT_DMESG="true"
RESTRICT_KPTR="true"
ENABLE_MODULES_DISABLED="false"

# -----------------------------------------------------------------------------
# Kernel command line (modules/15_kernel_cmdline.sh)
# KERNEL_CMDLINE_HARDEN: append boot-time mitigations to GRUB_CMDLINE_LINUX
#   (init_on_alloc/free, slab_nomerge, page_alloc.shuffle, vsyscall=none,
#   randomize_kstack_offset, spectre_v2=on, spec_store_bypass_disable=seccomp;
#   tsx=off when the CPU has TSX; lockdown=integrity only with Secure Boot).
#   GRUB is regenerated with verify-or-revert; takes effect on next reboot.
#   Expect a small performance cost from the speculative-execution settings.
# KERNEL_CMDLINE_EXTRA: extra space-separated parameters to append verbatim.
# -----------------------------------------------------------------------------
KERNEL_CMDLINE_HARDEN="no"
KERNEL_CMDLINE_EXTRA=""

# -----------------------------------------------------------------------------
# Lynis
# LYNIS_SOURCE: package | cisofy-repo | github
#   cisofy-repo (default) tracks the current upstream release — distro
#   packages lag and trigger Lynis's own "release is older than 4 months"
#   suggestion against you.
# LYNIS_QUICK: skip wait prompts when set to true.
# -----------------------------------------------------------------------------
LYNIS_SOURCE="cisofy-repo"
LYNIS_QUICK="true"

# -----------------------------------------------------------------------------
# Hetzner Cloud
# Replace __PLACEHOLDER__ values with your actual credentials.
# HETZNER_IMAGES: comma-separated list of images to test against.
# -----------------------------------------------------------------------------
HETZNER_API_TOKEN="__PLACEHOLDER__"
HETZNER_SSH_KEY_NAME="__PLACEHOLDER__"
HETZNER_SSH_KEY_PATH="~/.ssh/id_ed25519"
HETZNER_SERVER_TYPE="cx23"
HETZNER_LOCATION="fsn1"
HETZNER_IMAGES="debian-12,ubuntu-24.04,rocky-9,alma-9"

# -----------------------------------------------------------------------------
# Orchestration
# KEEP_ON_FAILURE: keep the server alive after a failed test run for debugging.
# ENABLE_ITERATION: re-run hardening until MIN_SCORE_DELTA is no longer met.
# MAX_ITERATIONS: maximum number of hardening iterations.
# MIN_SCORE_DELTA: minimum Lynis score improvement to trigger another iteration.
# ENABLE_REBOOT_TEST: reboot and re-check after hardening.
# PARALLEL_TESTS: run tests against multiple images concurrently.
# -----------------------------------------------------------------------------
KEEP_ON_FAILURE="false"
ENABLE_ITERATION="true"
MAX_ITERATIONS=3
MIN_SCORE_DELTA=1
ENABLE_REBOOT_TEST="false"
PARALLEL_TESTS="true"
